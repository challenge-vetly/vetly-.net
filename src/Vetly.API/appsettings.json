{
  "ConnectionStrings": {
    "OracleConnection": "User Id=SEU_USUARIO;Password=SUA_SENHA;Data Source=oracle.fiap.com.br:1521/orcl"
  },
  "Adaptadores": {
    "Crmv": "Simulado",
    "Pagamento": "Simulado",
    "Storage": "Local",
    "Stt": "Simulado",
    "Assinatura": "NomeDigitado",
    "Push": "Simulado",
    "Geocodificacao": "Simulado"
  },
  "Storage": {
    "Diretorio": "",
    "BaseUrl": "/api/storage",
    "PublicBaseUrl": "https://localhost:7262"
  },
  "NodeRed": {
    "BaseUrl": "http://localhost:1880"
  },
  "Servicos": {
    "TokenInterno": "DEFINA_UM_TOKEN_DE_SERVICO_LOCALMENTE",
    "CallbackBaseUrl": "https://localhost:7262"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1",
    "TimeoutSeconds": 120
  },
  "Jwt": {
    "Key": "SUA_JWT_SECRET_KEY_COM_MINIMO_32_CARACTERES",
    "Issuer": "Vetly",
    "Audience": "VetlyAPI"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Vetly": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vetly-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 20971520,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "vetly-api",
    "ExportarParaConsole": false,
    "Otlp": {
      "Endpoint": ""
    }
  },
  "AllowedHosts": "*"
}
