# Variaveis do docker-compose da VM. O deploy/azure-vm-deploy.ps1 gera o .env real
# (chmod 600, so na VM) — este arquivo existe para quem sobe a stack manualmente.
# Todos os valores abaixo sao placeholders: nenhum segredo de verdade entra no git.

VETLY_FQDN=vetly-exemplo.canadacentral.cloudapp.azure.com

ConnectionStrings__OracleConnection=User Id=SEU_USUARIO;Password=SUA_SENHA;Data Source=oracle.fiap.com.br:1521/orcl
Jwt__Key=SUA_JWT_SECRET_KEY_COM_MINIMO_32_CARACTERES
Jwt__Issuer=Vetly
Jwt__Audience=VetlyAPI
Servicos__TokenInterno=DEFINA_UM_TOKEN_DE_SERVICO_LOCALMENTE
Servicos__CallbackBaseUrl=https://vetly-exemplo.canadacentral.cloudapp.azure.com
Storage__PublicBaseUrl=https://vetly-exemplo.canadacentral.cloudapp.azure.com
Ollama__Model=llama3.1

# Transcricao: Simulado ou Azure (com as duas variaveis abaixo)
Adaptadores__Stt=Simulado
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=canadacentral

# Historico do avatar no MongoDB (Sprint 4). MONGO_USUARIO/MONGO_SENHA criam o usuario
# root na PRIMEIRA subida do volume; a connection string precisa usar a mesma senha.
# Senha so com [0-9a-f]: ela vai dentro da URI, onde + / = exigiriam escape.
MONGO_USUARIO=vetly
MONGO_SENHA=troque-por-uma-senha-hex
Adaptadores__DocumentoNoSql=Mongo
MongoDb__ConnectionString=mongodb://vetly:troque-por-uma-senha-hex@mongo:27017/?authSource=admin
MongoDb__Database=vetly
